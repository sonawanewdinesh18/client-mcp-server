{
  "mcpServers": {
    "neon_postgres": {
      "transport": "sse",
      "url": "https://mcp.neon.tech/sse",
      "headers": {},
      "enabled": false,
      "description": "Neon Serverless Postgres Database MCP Server"
    },
    "fetch_service": {
      "transport": "sse",
      "url": "http://localhost:8000/sse",
      "headers": {},
      "enabled": false,
      "description": "Custom Local/Remote SSE MCP Server"
    },
    "sqlite_demo": {
      "transport": "stdio",
      "command": "uvx",
      "args": [
        "mcp-server-sqlite",
        "--db-path",
        "sample.db"
      ],
      "env": {},
      "enabled": false,
      "description": "Local SQLite Database MCP Server (uvx)"
    }
  }
}